# Copy to .env and fill in your own values. Never commit the real .env file.

# Required in production (DEBUG=False), otherwise the app refuses to boot:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=

# Google OAuth2 credentials (required for "Continue with Google" login).
# Create a project at https://console.cloud.google.com/ -> APIs & Services ->
# Credentials -> OAuth client ID (Web application), then paste the values below.
# Add this Authorized redirect URI in the Google console:
#   http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to False in production (turns on secure cookies + HSTS).
DEBUG=True

# Comma separated hostnames. Use * for local development.
ALLOWED_HOSTS=*

# Comma separated origins. Required in production behind a proxy.
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Optional: production database URL (defaults to SQLite when empty).
# DATABASE_URL=postgres://user:password@localhost:5432/ricemandi
