# Copy to .env and fill in. Never commit .env.

# Local: leave DATABASE_URL empty to use SQLite.
# Production (Neon / Supabase / Render Postgres):
#   DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-before-deploying

# False in production.
DEBUG=True

# Comma separated. "*" is fine locally only.
ALLOWED_HOSTS=localhost,127.0.0.1

# Needed on Render so form CSRF passes behind the proxy.
# CSRF_TRUSTED_ORIGINS=https://yourapp.onrender.com
